# Local default. Leave DATABASE_URL empty to use inventory_app/inventory.db.
# DATABASE_URL=sqlite:////absolute/path/to/inventory.db

# Cloud PostgreSQL example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

SECRET_KEY=change-me
APP_HOST=127.0.0.1
APP_PORT=5001

# Created by python inventory_app/init_db.py when both values are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Optional ordinary user for permission testing.
USER_USERNAME=staff
USER_PASSWORD=change-this-user-password
